{
  "format": "turko-studio-project-v1",
  "name": "Hidroelektrik Santrali · HES-01",
  "language": "ST",
  "plant": false,
  "st": "PROGRAM MAIN\nIF URETIM_ISTEK AND NOT SICAKLIK_TEST THEN\n  KAPAK_YUZDE := KAPAK_YUZDE + (KAPAK_SET - KAPAK_YUZDE) * 0.18;\n  SEBEKE_BAGLI := TRUE;\n  UNITE_MODU := 1;\nELSE\n  KAPAK_YUZDE := KAPAK_YUZDE * 0.82;\n  SEBEKE_BAGLI := FALSE;\n  UNITE_MODU := 0;\nEND_IF;\nDEBI_M3S := KAPAK_YUZDE * 0.94;\nIF SEBEKE_BAGLI THEN\n  TURBIN_RPM := 300.0;\n  FREKANS_HZ := 50.0;\n  GUC_MW := DEBI_M3S * DUSU_M * 0.0088;\nELSE\n  TURBIN_RPM := TURBIN_RPM * 0.87;\n  FREKANS_HZ := 0.0;\n  GUC_MW := 0.0;\nEND_IF;\nIF SICAKLIK_TEST THEN\n  UNITE_MODU := 2;\n  GEN_SICAKLIK := 92.0;\nELSE\n  GEN_SICAKLIK := GEN_SICAKLIK + (28.0 + GUC_MW * 0.7 - GEN_SICAKLIK) * 0.12;\nEND_IF;\nENERJI_MWH := ENERJI_MWH + GUC_MW / 18000.0;\nEND_PROGRAM",
